From 26d8867a4cec1deba05226c870dcf03d45fbbc3e Mon Sep 17 00:00:00 2001
From: FormalSnake <kyaniserni@gmail.com>
Date: Sun, 22 Nov 2026 15:02:12 +0000
Subject: [PATCH] gpui_linux: read the clipboard from the data control offer

With ext-data-control bound, the selection change counted is the data
control device's, and the data device's offer of it comes only with the
keyboard focus, so it can come later or not at all. A read right after
the count saw the previous selection. Reads now take the data control
offer of the counted selection, and fall back to the data device's
without data control.
---
 crates/gpui_linux/src/linux/wayland/client.rs | 16 ++++-
 .../gpui_linux/src/linux/wayland/clipboard.rs | 67 +++++++++++++++----
 2 files changed, 68 insertions(+), 15 deletions(-)

diff --git a/crates/gpui_linux/src/linux/wayland/client.rs b/crates/gpui_linux/src/linux/wayland/client.rs
index cd16c78e6a..23283f31e7 100644
--- a/crates/gpui_linux/src/linux/wayland/client.rs
+++ b/crates/gpui_linux/src/linux/wayland/client.rs
@@ -1004,6 +1004,7 @@ impl WaylandClientState {
         for (offer, _) in self.data_control_offers.drain(..) {
             offer.destroy();
         }
+        self.clipboard.set_control_offer(None);
         self.wl_seat.release();
         self.wl_seat_name = None;
         if let Some((name, version)) = next {
@@ -3549,10 +3550,18 @@ impl Dispatch<ext_data_control_device_v1::ExtDataControlDeviceV1, ()> for Waylan
                         .map(|(_, mime_types)| mime_types.as_slice())
                 });
                 let kind = SelectionKind::of(mime_types, &state.clipboard.self_mime());
-                selection_changed(kind);
-                for (offer, _) in state.data_control_offers.drain(..) {
-                    offer.destroy();
+                let mut selected = None;
+                for (offer, mime_types) in state.data_control_offers.drain(..) {
+                    if id.as_ref() == Some(&offer) {
+                        selected = Some(DataOffer::with_mime_types(offer, mime_types));
+                    } else {
+                        offer.destroy();
+                    }
                 }
+                // The selection is read from this offer, the one just counted, as the
+                // data device's comes only with the keyboard focus and can come later.
+                state.clipboard.set_control_offer(Some(selected));
+                selection_changed(kind);
             }
             ext_data_control_device_v1::Event::PrimarySelection { id: Some(selected) } => {
                 state.data_control_offers.retain(|(offer, _)| *offer != selected);
@@ -3564,6 +3573,7 @@ impl Dispatch<ext_data_control_device_v1::ExtDataControlDeviceV1, ()> for Waylan
                 for (offer, _) in state.data_control_offers.drain(..) {
                     offer.destroy();
                 }
+                state.clipboard.set_control_offer(None);
             }
             _ => {}
         }
diff --git a/crates/gpui_linux/src/linux/wayland/clipboard.rs b/crates/gpui_linux/src/linux/wayland/clipboard.rs
index 99e19461f0..3896e8d928 100644
--- a/crates/gpui_linux/src/linux/wayland/clipboard.rs
+++ b/crates/gpui_linux/src/linux/wayland/clipboard.rs
@@ -8,6 +8,7 @@ use calloop::{LoopHandle, PostAction};
 use filedescriptor::Pipe;
 use strum::IntoEnumIterator;
 use wayland_client::{Connection, protocol::wl_data_offer::WlDataOffer};
+use wayland_protocols::ext::data_control::v1::client::ext_data_control_offer_v1::ExtDataControlOfferV1;
 use wayland_protocols::wp::primary_selection::zv1::client::zwp_primary_selection_offer_v1::ZwpPrimarySelectionOfferV1;
 
 use crate::linux::platform::{PIPE_READ_TIMEOUT, read_fd_with_timeout};
@@ -93,10 +94,19 @@ pub(crate) struct Clipboard {
     // External clipboard
     cached_read: Option<ClipboardItem>,
     current_offer: Option<DataOffer<WlDataOffer>>,
+    /// With data control bound, its offer of the selection (None when there is no
+    /// selection). Reads take it over the data device's, which follows the focus.
+    control_offer: Option<Option<DataOffer<ExtDataControlOfferV1>>>,
     cached_primary_read: Option<ClipboardItem>,
     current_primary_offer: Option<DataOffer<ZwpPrimarySelectionOfferV1>>,
 }
 
+/// What an offer of the selection holds: this client's own copy, or another's content.
+enum Read {
+    Own,
+    Foreign(ClipboardItem),
+}
+
 pub(crate) trait ReceiveData {
     fn receive_data(&self, mime_type: String, fd: BorrowedFd<'_>);
 }
@@ -113,6 +123,12 @@ impl ReceiveData for ZwpPrimarySelectionOfferV1 {
     }
 }
 
+impl ReceiveData for ExtDataControlOfferV1 {
+    fn receive_data(&self, mime_type: String, fd: BorrowedFd<'_>) {
+        self.receive(mime_type, fd);
+    }
+}
+
 #[derive(Clone, Debug)]
 /// Wrapper for `WlDataOffer` and `ZwpPrimarySelectionOfferV1`, used to help track mime types.
 pub(crate) struct DataOffer<T: ReceiveData> {
@@ -128,6 +144,13 @@ impl<T: ReceiveData> DataOffer<T> {
         }
     }
 
+    pub fn with_mime_types(offer: T, mime_types: Vec<String>) -> Self {
+        Self {
+            inner: offer,
+            mime_types,
+        }
+    }
+
     pub fn add_mime_type(&mut self, mime_type: String) {
         self.mime_types.push(mime_type)
     }
@@ -155,6 +178,15 @@ impl<T: ReceiveData> DataOffer<T> {
         }
     }
 
+    fn read(&self, self_mime: &str, connection: &Connection) -> Option<Read> {
+        if self.has_mime_type(self_mime) {
+            return Some(Read::Own);
+        }
+        self.read_text(connection)
+            .or_else(|| self.read_image(connection))
+            .map(Read::Foreign)
+    }
+
     fn read_text(&self, connection: &Connection) -> Option<ClipboardItem> {
         let mime_type = ALLOWED_TEXT_MIME_TYPES
             .iter()
@@ -205,6 +237,7 @@ impl Clipboard {
 
             cached_read: None,
             current_offer: None,
+            control_offer: None,
             cached_primary_read: None,
             current_primary_offer: None,
         }
@@ -223,10 +256,21 @@ impl Clipboard {
     }
 
     pub fn set_offer(&mut self, data_offer: Option<DataOffer<WlDataOffer>>) {
-        self.cached_read = None;
+        if self.control_offer.is_none() {
+            self.cached_read = None;
+        }
         self.current_offer = data_offer;
     }
 
+    /// The data control device's offer of a new selection, `Some(None)` for none, or
+    /// None once that device is gone.
+    pub fn set_control_offer(&mut self, offer: Option<Option<DataOffer<ExtDataControlOfferV1>>>) {
+        self.cached_read = None;
+        if let Some(Some(previous)) = std::mem::replace(&mut self.control_offer, offer) {
+            previous.inner.destroy();
+        }
+    }
+
     pub fn set_primary_offer(&mut self, data_offer: Option<DataOffer<ZwpPrimarySelectionOfferV1>>) {
         self.cached_primary_read = None;
         self.current_primary_offer = data_offer;
@@ -253,21 +297,20 @@ impl Clipboard {
     }
 
     pub fn read(&mut self) -> Option<ClipboardItem> {
-        let offer = self.current_offer.as_ref()?;
         if let Some(cached) = self.cached_read.clone() {
             return Some(cached);
         }
-
-        if offer.has_mime_type(&self.self_mime) {
-            return self.contents.clone();
+        let read = match &self.control_offer {
+            Some(offer) => offer.as_ref()?.read(&self.self_mime, &self.connection),
+            None => self.current_offer.as_ref()?.read(&self.self_mime, &self.connection),
+        };
+        match read? {
+            Read::Own => self.contents.clone(),
+            Read::Foreign(item) => {
+                self.cached_read = Some(item.clone());
+                Some(item)
+            }
         }
-
-        let item = offer
-            .read_text(&self.connection)
-            .or_else(|| offer.read_image(&self.connection))?;
-
-        self.cached_read = Some(item.clone());
-        Some(item)
     }
 
     pub fn read_primary(&mut self) -> Option<ClipboardItem> {
-- 
2.56.0

