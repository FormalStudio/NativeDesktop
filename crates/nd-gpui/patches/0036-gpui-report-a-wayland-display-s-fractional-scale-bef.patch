From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: FormalSnake <kyaniserni@gmail.com>
Date: Tue, 17 Nov 2026 10:44:39 +0000
Subject: [PATCH 36/37] gpui: report a wayland display's fractional scale
 before any window shows

---
 crates/gpui/src/platform.rs                    |  6 ++++++
 crates/gpui_linux/src/linux/wayland/client.rs  | 12 ++++++++++++
 crates/gpui_linux/src/linux/wayland/display.rs |  5 +++++
 crates/gpui_linux/src/linux/wayland/window.rs  |  1 +
 4 files changed, 24 insertions(+)

diff --git a/crates/gpui/src/platform.rs b/crates/gpui/src/platform.rs
index 2397ebb204..d3c77edb10 100644
--- a/crates/gpui/src/platform.rs
+++ b/crates/gpui/src/platform.rs
@@ -653,6 +653,12 @@ pub trait PlatformDisplay: Debug {
     /// [`Window::refresh_interval`](crate::Window::refresh_interval).
     fn refresh_interval(&self) -> Option<Duration>;
 
+    /// Device pixels per logical pixel on this display, before any window
+    /// is shown on it. `None` when the platform doesn't report it.
+    fn scale_factor(&self) -> Option<f32> {
+        None
+    }
+
     /// Get the visible bounds for this display, excluding taskbar/dock areas.
     /// This is the usable area where windows can be placed without being obscured.
     /// Defaults to the full display bounds if not overridden.
diff --git a/crates/gpui_linux/src/linux/wayland/client.rs b/crates/gpui_linux/src/linux/wayland/client.rs
index d682c839e6..6ac0d68078 100644
--- a/crates/gpui_linux/src/linux/wayland/client.rs
+++ b/crates/gpui_linux/src/linux/wayland/client.rs
@@ -389,6 +389,17 @@ impl Output {
             None => self.bounds.to_pixels(scale),
         }
     }
+
+    /// Mode pixels per logical pixel: fractional when the compositor scales
+    /// the output by a fraction, which `scale` rounds up to an integer. The
+    /// larger sides are compared, since a rotated output's logical size is
+    /// transformed and its mode is not.
+    pub fn scale_factor(&self) -> f32 {
+        let Some(l) = self.logical else { return self.scale as f32 };
+        let mode = self.bounds.size.width.0.max(self.bounds.size.height.0);
+        let logical = l.size.width.0.max(l.size.height.0);
+        if logical > 0 { mode as f32 / logical as f32 } else { self.scale as f32 }
+    }
 }
 
 pub(crate) struct WaylandClientState {
@@ -1312,6 +1323,7 @@ impl WaylandConnection {
                     id: id.clone(),
                     name: output.name.clone(),
                     bounds: output.logical_bounds(output.scale as f32),
+                    scale: output.scale_factor(),
                     refresh_interval: output.refresh_interval,
                 }) as Rc<dyn PlatformDisplay>
             })
diff --git a/crates/gpui_linux/src/linux/wayland/display.rs b/crates/gpui_linux/src/linux/wayland/display.rs
index 410f45080f..f240e41fba 100644
--- a/crates/gpui_linux/src/linux/wayland/display.rs
+++ b/crates/gpui_linux/src/linux/wayland/display.rs
@@ -16,6 +16,7 @@ pub(crate) struct WaylandDisplay {
     pub id: ObjectId,
     pub name: Option<String>,
     pub bounds: Bounds<Pixels>,
+    pub scale: f32,
     pub refresh_interval: Option<Duration>,
 }
 
@@ -45,6 +46,10 @@ impl PlatformDisplay for WaylandDisplay {
     fn refresh_interval(&self) -> Option<Duration> {
         self.refresh_interval
     }
+
+    fn scale_factor(&self) -> Option<f32> {
+        Some(self.scale)
+    }
 }
 
 /// Converts a `wl_output.mode` refresh rate, in millihertz, to an interval.
diff --git a/crates/gpui_linux/src/linux/wayland/window.rs b/crates/gpui_linux/src/linux/wayland/window.rs
index 09161aeb9e..ded10a86e6 100644
--- a/crates/gpui_linux/src/linux/wayland/window.rs
+++ b/crates/gpui_linux/src/linux/wayland/window.rs
@@ -2066,6 +2066,7 @@ impl PlatformWindow for WaylandWindow {
             id,
             name: display.name.clone(),
             bounds: display.logical_bounds(state.scale),
+            scale: display.scale_factor(),
             refresh_interval: display.refresh_interval,
         }))
     }
