     pub edge: Option<[f32; 5]>,
+    /// From [`BackdropFilter::sharp`]; Metal and Direct3D blur all of it.
+    pub sharp: f32,
 }
 
 /// Coverage a backdrop is multiplied by, for a clip a content mask cannot hold (a circle, a
@@ -1188,6 +1190,7 @@ mod tests {
