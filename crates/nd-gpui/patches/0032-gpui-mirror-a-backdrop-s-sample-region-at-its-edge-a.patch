From: FormalSnake <kyaniserni@gmail.com>
Date: Thu, 12 Nov 2026 13:04:45 +0000
Subject: [PATCH 32/32] gpui: mirror a backdrop's sample region at its edge and
 clamp its tinted result

---
 crates/gpui/src/scene.rs                |   6 +
 crates/gpui/src/style.rs                |  19 +++
 crates/gpui/src/window.rs               |   2 +
 crates/gpui_apple/src/metal_renderer.rs |   2 +
 crates/gpui_wgpu/src/backdrop.rs        | 202 +++++++++++++++++++++++-
 crates/gpui_wgpu/src/wgpu_renderer.rs   |   2 +
 6 files changed, 230 insertions(+), 3 deletions(-)

diff --git a/crates/gpui/src/scene.rs b/crates/gpui/src/scene.rs
index c592407b8f..ff69c9dadd 100644
--- a/crates/gpui/src/scene.rs
+++ b/crates/gpui/src/scene.rs
@@ -698,6 +698,10 @@ pub struct Backdrop {
     pub fallback: Hsla,
     /// One more than the index of its mask in [`Scene::backdrop_masks`], 0 for none.
     pub mask: u32,
+    /// From [`BackdropFilter::mirror`]; Metal and Direct3D repeat the edge.
+    pub mirror: bool,
+    /// From [`BackdropFilter::clamp`]; Metal and Direct3D clamp the saturated blur to 0.
+    pub clamp: Option<[f32; 2]>,
 }
 
 /// Coverage a backdrop is multiplied by, for a clip a content mask cannot hold (a circle, a
@@ -1176,6 +1180,8 @@ mod tests {
             opacity: 1.,
             fallback: Hsla::default(),
             mask: 0,
+            mirror: false,
+            clamp: None,
         }
     }
 
diff --git a/crates/gpui/src/style.rs b/crates/gpui/src/style.rs
index bf1f08c6a1..2e5d0f219c 100644
--- a/crates/gpui/src/style.rs
+++ b/crates/gpui/src/style.rs
@@ -372,6 +372,11 @@ pub struct BackdropFilter {
     /// around them, so an element at the content's edge does not blur that in.
     #[serde(skip)]
     pub within: Option<Bounds<Pixels>>,
+    /// Reflects `within` at its edge instead of repeating the edge.
+    pub mirror: bool,
+    /// Leaves the saturated blur unclamped and clamps each channel of the tinted result to
+    /// this range (sRGB) instead, as macOS's materials do.
+    pub clamp: Option<[f32; 2]>,
 }
 
 impl Default for BackdropFilter {
@@ -385,6 +390,8 @@ impl Default for BackdropFilter {
             highlight_width: px(1.),
             fallback: Hsla::transparent_black(),
             within: None,
+            mirror: false,
+            clamp: None,
         }
     }
 }
@@ -434,6 +441,18 @@ impl BackdropFilter {
         self.within = Some(bounds);
         self
     }
+
+    /// Reflects the area set by [`Self::within`] at its edge instead of repeating the edge.
+    pub fn mirrored(mut self) -> Self {
+        self.mirror = true;
+        self
+    }
+
+    /// Clamps the tinted result to `low..=high` instead of the saturated blur to 0.
+    pub fn clamped(mut self, low: f32, high: f32) -> Self {
+        self.clamp = Some([low, high]);
+        self
+    }
 }
 
 /// The possible values of the box-shadow property
diff --git a/crates/gpui/src/window.rs b/crates/gpui/src/window.rs
