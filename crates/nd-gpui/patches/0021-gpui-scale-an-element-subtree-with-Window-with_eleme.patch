+    #[gpui::test]
+    fn test_element_scale_maps_paint_and_hit_testing(cx: &mut TestAppContext) {
+        struct Scaled(Rc<Cell<Option<crate::HitboxId>>>);
+
+        impl Render for Scaled {
+            fn render(&mut self, _: &mut Window, _: &mut Context<Self>) -> impl IntoElement {
+                let id = self.0.clone();
+                div().size_full().child(
+                    canvas(
+                        move |bounds, window, _| {
+                            window.with_element_scale(0.5, bounds.center(), |window| {
+                                let hitbox =
+                                    window.insert_hitbox(bounds, crate::HitboxBehavior::Normal);
+                                id.set(Some(hitbox.id));
+                            })
+                        },
+                        |bounds, (), window, _| {
+                            window.with_element_scale(0.5, bounds.center(), |window| {
+                                window.paint_quad(
+                                    crate::fill(bounds, crate::rgb(0xff0000)).corner_radii(px(8.)),
+                                );
+                            })
+                        },
+                    )
+                    .w(px(100.))
+                    .h(px(60.)),
+                )
+            }
+        }
+
+        let id = Rc::new(Cell::new(None));
+        let window = cx.add_window({
+            let id = id.clone();
+            move |_, _| Scaled(id)
+        });
+        cx.update_window(window.into(), |_, window, cx| {
+            window.draw(cx).clear(cx);
+            let s = window.scale_factor();
+            let quad = &window.rendered_frame.scene.quads[0];
+            assert_eq!(
+                quad.bounds,
+                Bounds {
+                    origin: point(ScaledPixels(25. * s), ScaledPixels(15. * s)),
+                    size: size(ScaledPixels(50. * s), ScaledPixels(30. * s)),
+                }
+            );
+            assert_eq!(quad.corner_radii.top_left, ScaledPixels(4. * s));
+            let id = id.get().expect("hitbox inserted");
+            let hits = |x: f32, y: f32| {
+                window
+                    .rendered_frame
+                    .hit_test(point(px(x), px(y)))
+                    .ids
+                    .contains(&id)
+            };
+            assert!(hits(30., 20.), "inside the drawn quad");
+            assert!(!hits(10., 10.), "inside the layout box, outside the drawn quad");
+        })
+        .unwrap();
+    }
