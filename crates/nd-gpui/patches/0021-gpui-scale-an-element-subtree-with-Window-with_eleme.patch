+    /// Draws everything `f` prepaints and paints scaled by `scale` about `origin`, without
+    /// changing its layout. Call it around both the prepaint and the paint of the same elements.
+    ///
+    /// Inside, bounds and [`Self::content_mask`] stay in layout space; quads, borders, shadows,
+    /// paths, text, images and surfaces are mapped to the window as they reach the scene, and
+    /// hitboxes are stored mapped, so hit testing follows what is drawn. Glyphs, SVGs and images
+    /// are sampled from their unscaled raster. Deferred draws escape the scale, as they escape
+    /// clipping, and views inside it are redrawn rather than reused from the last frame.
+    pub fn with_element_scale<R>(
+        &mut self,
+        scale: f32,
+        origin: Point<Pixels>,
+        f: impl FnOnce(&mut Self) -> R,
+    ) -> R {
+        self.invalidator.debug_assert_paint_or_prepaint();
+        if scale == 1. {
+            return f(self);
+        }
+        // A zero scale has no inverse for the clip; a hair above it draws nothing visible.
+        let local = ElementTransform::scale_about(scale.max(1e-4), origin);
+        let mask = ContentMask {
+            bounds: local.invert_bounds(self.content_mask().bounds),
+        };
+        let previous = self.element_transform;
+        self.element_transform = previous.then(local);
+        let refreshing = mem::replace(&mut self.refreshing, true);
+        self.content_mask_stack.push(mask);
+        let result = f(self);
+        self.content_mask_stack.pop();
+        self.refreshing = refreshing;
+        self.element_transform = previous;
+        result
+    }
+
+    /// The transform [`Self::with_element_scale`] applies to what is drawn now.
+    pub fn element_transform(&self) -> ElementTransform {
+        self.element_transform
+    }
