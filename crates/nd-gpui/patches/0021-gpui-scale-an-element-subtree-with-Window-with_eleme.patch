 /// A rectangular region that potentially blocks hitboxes inserted prior.
+/// A uniform scale and translation from an element subtree's layout space to the window, set by
+/// [`Window::with_element_scale`].
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct ElementTransform {
+    /// The factor lengths are multiplied by.
+    pub scale: f32,
+    /// Where the layout-space origin lands in the window.
+    pub translation: Point<Pixels>,
+}
+
+impl ElementTransform {
+    /// Leaves every point where it is.
+    pub const IDENTITY: Self = Self {
+        scale: 1.,
+        translation: Point {
+            x: Pixels::ZERO,
+            y: Pixels::ZERO,
+        },
+    };
+
+    /// Whether this transform leaves every point where it is.
+    pub fn is_identity(&self) -> bool {
+        *self == Self::IDENTITY
+    }
+
+    /// Scales by `scale` about `origin`, which stays where it is.
+    pub fn scale_about(scale: f32, origin: Point<Pixels>) -> Self {
+        Self {
+            scale,
+            translation: origin.map(|c| c * (1. - scale)),
+        }
+    }
+
+    /// `other` applied first, then `self`.
+    pub fn then(&self, other: Self) -> Self {
+        Self {
+            scale: self.scale * other.scale,
+            translation: self.apply(other.translation),
+        }
+    }
+
+    /// Maps a layout-space point to the window.
+    pub fn apply(&self, point: Point<Pixels>) -> Point<Pixels> {
+        point.map(|c| c * self.scale) + self.translation
+    }
+
+    /// Maps a window point back to layout space.
+    pub fn invert(&self, point: Point<Pixels>) -> Point<Pixels> {
+        (point - self.translation).map(|c| c * self.scale.recip())
+    }
+
+    /// Maps layout-space bounds to the window.
+    pub fn apply_bounds(&self, bounds: Bounds<Pixels>) -> Bounds<Pixels> {
+        Bounds {
+            origin: self.apply(bounds.origin),
+            size: bounds.size.map(|c| c * self.scale),
+        }
+    }
+
+    /// Maps window bounds back to layout space.
+    pub fn invert_bounds(&self, bounds: Bounds<Pixels>) -> Bounds<Pixels> {
+        Bounds {
+            origin: self.invert(bounds.origin),
+            size: bounds.size.map(|c| c * self.scale.recip()),
+        }
+    }
+
+    fn apply_device(&self, bounds: Bounds<ScaledPixels>, scale_factor: f32) -> Bounds<ScaledPixels> {
+        let translation = self.translation.scale(scale_factor);
+        Bounds {
+            origin: bounds.origin.map(|c| c * self.scale) + translation,
+            size: bounds.size.map(|c| c * self.scale),
+        }
+    }
+}
