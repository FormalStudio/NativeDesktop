From 55688caf9d079f4a382f9814508fa910376cee12 Mon Sep 17 00:00:00 2001
From: FormalSnake <kyaniserni@gmail.com>
Date: Thu, 26 Nov 2026 19:07:59 +0000
Subject: [PATCH 42/42] gpui_wgpu: keep the two-argument create_surface that
 gpui-fast's composition calls

---
 crates/gpui_wgpu/src/wgpu_renderer.rs | 18 +++++++++++++-----
 1 file changed, 13 insertions(+), 5 deletions(-)

diff --git a/crates/gpui_wgpu/src/wgpu_renderer.rs b/crates/gpui_wgpu/src/wgpu_renderer.rs
index be4d288c49..363e5369fb 100644
--- a/crates/gpui_wgpu/src/wgpu_renderer.rs
+++ b/crates/gpui_wgpu/src/wgpu_renderer.rs
@@ -592,7 +592,7 @@ impl WgpuRenderer {
         let surface_configured = ctx_ref.is_none();
         let (context, surface) = match ctx_ref.as_mut() {
             Some(context) => {
-                let surface = create_surface(&context.instance, display_handle, window_handle.as_raw())
+                let surface = create_surface_on(&context.instance, display_handle, window_handle.as_raw())
                     .map_err(|e| anyhow::anyhow!("Failed to create surface: {e}"))?;
                 context.check_compatible_with_surface(&surface)?;
                 (context, surface)
@@ -600,7 +600,7 @@ impl WgpuRenderer {
             None => {
                 let (context, surface) = WgpuContext::new_with_surface(
                     || Box::new(window.clone()),
-                    |instance| create_surface(instance, display_handle, window_handle.as_raw()),
+                    |instance| create_surface_on(instance, display_handle, window_handle.as_raw()),
                     &config,
                     compositor_gpu,
                     false,
@@ -2654,7 +2654,7 @@ impl WgpuRenderer {
             .window_handle()
             .map_err(|e| anyhow::anyhow!("Failed to get window handle: {e}"))?;
 
-        let surface = create_surface(instance, None, window_handle.as_raw())?;
+        let surface = create_surface(instance, window_handle.as_raw())?;
 
         let width = (config.size.width.0 as u32).max(1);
         let height = (config.size.height.0 as u32).max(1);
@@ -2759,7 +2759,7 @@ impl WgpuRenderer {
 
             let (new_context, surface) = WgpuContext::new_with_surface(
                 || Box::new(window.clone()),
-                |instance| create_surface(instance, display_handle, window_handle.as_raw()),
+                |instance| create_surface_on(instance, display_handle, window_handle.as_raw()),
                 &config,
                 self.compositor_gpu,
                 true,
@@ -2769,7 +2769,7 @@ impl WgpuRenderer {
         } else {
             let ctx_ref = gpu_context.borrow();
             let instance = &ctx_ref.as_ref().unwrap().instance;
-            create_surface(instance, display_handle, window_handle.as_raw())?
+            create_surface_on(instance, display_handle, window_handle.as_raw())?
         };
 
         let gpu_context = Rc::clone(gpu_context);
@@ -3087,6 +3087,14 @@ fn instance_range(range: Range<usize>) -> Range<u32> {
 
 #[cfg(not(target_family = "wasm"))]
 fn create_surface(
+    instance: &wgpu::Instance,
+    raw_window_handle: raw_window_handle::RawWindowHandle,
+) -> anyhow::Result<wgpu::Surface<'static>> {
+    create_surface_on(instance, None, raw_window_handle)
+}
+
+#[cfg(not(target_family = "wasm"))]
+fn create_surface_on(
     instance: &wgpu::Instance,
     raw_display_handle: Option<raw_window_handle::RawDisplayHandle>,
     raw_window_handle: raw_window_handle::RawWindowHandle,
-- 
2.56.0

