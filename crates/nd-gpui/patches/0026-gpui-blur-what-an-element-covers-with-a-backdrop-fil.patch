+                    Params {
+                        src_origin: origin,
+                        src_size: [r.width as f32, r.height as f32],
+                        dst_origin: origin,
+                        dst_size: reduced,
+                        factor: r.factor as f32,
+                        ..base
+                    }
+                } else {
+                    Params {
+                        src_origin: origin,
+                        src_size: reduced,
+                        dst_origin: origin,
+                        dst_size: reduced,
+                        direction: if step == 1 { [1., 0.] } else { [0., 1.] },
+                        sigma: backdrop.blur_radius.0 / r.factor as f32,
+                        ..base
+                    }
+                };
