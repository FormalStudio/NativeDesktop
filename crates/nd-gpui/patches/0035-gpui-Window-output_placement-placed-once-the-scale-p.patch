From 50e2a314cfcc02d7e1eb9ddb256cbdbe7b5c4fd1 Mon Sep 17 00:00:00 2001
From: FormalSnake <kyaniserni@gmail.com>
Date: Sun, 22 Nov 2026 06:25:55 +0000
Subject: [PATCH 35/35] gpui: Window::output_placement, placed once the scale
 protocol in use gives the window a scale

---
 crates/gpui/src/platform.rs                   | 16 ++++++++++
 crates/gpui/src/platform/test/window.rs       |  4 +++
 crates/gpui/src/window.rs                     |  6 ++++
 .../gpui_linux/src/linux/headless/window.rs   |  4 +++
 crates/gpui_linux/src/linux/wayland/window.rs | 30 ++++++++++++++++---
 5 files changed, 56 insertions(+), 4 deletions(-)

diff --git a/crates/gpui/src/platform.rs b/crates/gpui/src/platform.rs
index 2397ebb204..5642dbc4b4 100644
--- a/crates/gpui/src/platform.rs
+++ b/crates/gpui/src/platform.rs
@@ -845,6 +845,17 @@ pub enum Decorations {
     },
 }
 
+/// Where a window stands with the output it shows on.
+#[derive(Debug, Copy, Clone, PartialEq, Eq)]
+pub enum OutputPlacement {
+    /// Not on an output yet, or its scale from the compositor is still to come.
+    Pending,
+    /// On an output, and `scale_factor` is the scale the compositor asked for.
+    Placed,
+    /// Never on an output: a headless or test window.
+    Offscreen,
+}
+
 /// A configure from the compositor (Wayland `xdg_surface.configure`, X11 `ConfigureNotify`),
 /// reported once per configure as it arrives, in order, before the window applies it. Sizes are
 /// window geometry: the window without its client inset.
@@ -1447,6 +1458,11 @@ pub trait PlatformWindow: HasWindowHandle + HasDisplayHandle {
     }
     fn set_client_inset(&self, _inset: Pixels) {}
     fn on_configure(&self, _callback: Box<dyn FnMut(Configure)>) {}
+    /// Whether `scale_factor` is the scale of the output the window shows on. A window is on its
+    /// screen once created, except under Wayland, where the compositor places it later.
+    fn output_placement(&self) -> OutputPlacement {
+        OutputPlacement::Placed
+    }
     fn set_client_corner_radii(&self, _radii: Corners<Pixels>) {}
     fn gpu_specs(&self) -> Option<GpuSpecs>;
 
diff --git a/crates/gpui/src/platform/test/window.rs b/crates/gpui/src/platform/test/window.rs
index cd5f5b36e6..328ff3ab09 100644
--- a/crates/gpui/src/platform/test/window.rs
+++ b/crates/gpui/src/platform/test/window.rs
@@ -631,6 +631,10 @@ impl PlatformWindow for TestWindow {
 
     fn update_ime_position(&self, _bounds: Bounds<Pixels>) {}
 
+    fn output_placement(&self) -> crate::OutputPlacement {
+        crate::OutputPlacement::Offscreen
+    }
+
     fn gpu_specs(&self) -> Option<GpuSpecs> {
         None
     }
diff --git a/crates/gpui/src/window.rs b/crates/gpui/src/window.rs
index 730ed1e4a6..1a36e4e417 100644
--- a/crates/gpui/src/window.rs
+++ b/crates/gpui/src/window.rs
@@ -3335,6 +3335,12 @@ impl Window {
         self.platform_window.on_configure(Box::new(callback));
     }
 
+    /// Whether the window is on an output and `scale_factor` is that output's scale rather than
+    /// the default. A redraw follows the event that places the window.
+    pub fn output_placement(&self) -> crate::OutputPlacement {
+        self.platform_window.output_placement()
+    }
+
     /// Sets the client-drawn corner radii so platform effects can match the window's shape.
     pub fn set_client_corner_radii(&mut self, radii: Corners<Pixels>) {
         self.platform_window.set_client_corner_radii(radii);
diff --git a/crates/gpui_linux/src/linux/headless/window.rs b/crates/gpui_linux/src/linux/headless/window.rs
index add390f1b6..5040dbd064 100644
--- a/crates/gpui_linux/src/linux/headless/window.rs
+++ b/crates/gpui_linux/src/linux/headless/window.rs
@@ -202,6 +202,10 @@ impl PlatformWindow for HeadlessWindow {
 
     fn update_ime_position(&self, _bounds: Bounds<Pixels>) {}
 
+    fn output_placement(&self) -> gpui::OutputPlacement {
+        gpui::OutputPlacement::Offscreen
+    }
+
     fn gpu_specs(&self) -> Option<GpuSpecs> {
         None
     }
diff --git a/crates/gpui_linux/src/linux/wayland/window.rs b/crates/gpui_linux/src/linux/wayland/window.rs
index 71f1502ca3..5ba05da39d 100644
--- a/crates/gpui_linux/src/linux/wayland/window.rs
+++ b/crates/gpui_linux/src/linux/wayland/window.rs
@@ -275,6 +275,9 @@ pub struct WaylandWindowState {
     /// window's exact size.
     viewport_source: Option<Size<DevicePixels>>,
     last_presentation: Option<gpui::PresentationTime>,
+    /// The scale protocol in use (fractional scale, else the preferred buffer scale, else the
+    /// entered outputs' scale) has applied a scale. With `outputs` it makes the window placed.
+    scaled: bool,
     in_progress_window_controls: Option<WindowControls>,
     window_controls: WindowControls,
     client_inset: Option<Pixels>,
@@ -824,6 +827,7 @@ impl WaylandWindowState {
             live_resize: false,
             viewport_source: None,
             last_presentation: None,
+            scaled: false,
             client,
             appearance,
             handle,
@@ -858,6 +862,13 @@ impl WaylandWindowState {
         }
     }
 
+    /// Whether the window takes its scale from the outputs it entered: the compositor offers
+    /// neither fractional scale nor `preferred_buffer_scale`.
+    fn scale_from_outputs(&self) -> bool {
+        self.globals.fractional_scale_manager.is_none()
+            && self.surface.version() < wl_surface::EVT_PREFERRED_BUFFER_SCALE_SINCE
+    }
+
     pub fn primary_output_scale(&mut self) -> i32 {
         let mut scale = 1;
         // Keep the display the surface last left only while it is on no
@@ -1442,6 +1453,7 @@ impl WaylandWindowStatePtr {
     pub fn handle_fractional_scale_event(&self, event: wp_fractional_scale_v1::Event) {
         if let wp_fractional_scale_v1::Event::PreferredScale { scale } = event {
             self.rescale(scale as f32 / 120.0);
+            self.state.borrow_mut().scaled = true;
             self.request_redraw();
         }
     }
@@ -1652,11 +1664,11 @@ impl WaylandWindowStatePtr {
                     state.display.as_ref().map(|(id, _)| id) != previous_display.as_ref();
                 state.update_subpixel_layout();
 
-                // We use `PreferredBufferScale` instead to set the scale if it's available
-                if state.surface.version() < wl_surface::EVT_PREFERRED_BUFFER_SCALE_SINCE {
+                if state.scale_from_outputs() {
                     state.surface.set_buffer_scale(scale);
                     drop(state);
                     self.rescale(scale as f32);
+                    self.state.borrow_mut().scaled = true;
                 } else {
                     drop(state);
                 }
@@ -1674,8 +1686,8 @@ impl WaylandWindowStatePtr {
                     state.display.as_ref().map(|(id, _)| id) != previous_display.as_ref();
                 state.update_subpixel_layout();
 
-                // We use `PreferredBufferScale` instead to set the scale if it's available
-                if state.surface.version() < wl_surface::EVT_PREFERRED_BUFFER_SCALE_SINCE {
+                // Off every output the window keeps its last scale until an output gives it one.
+                if state.scale_from_outputs() && !state.outputs.is_empty() {
                     state.surface.set_buffer_scale(scale);
                     drop(state);
                     self.rescale(scale as f32);
@@ -1693,6 +1705,7 @@ impl WaylandWindowStatePtr {
                     state.surface.set_buffer_scale(factor);
                     drop(state);
                     self.rescale(factor as f32);
+                    self.state.borrow_mut().scaled = true;
                     self.request_redraw();
                 }
             }
@@ -2538,6 +2551,15 @@ impl PlatformWindow for WaylandWindow {
         self.borrow().last_presentation
     }
 
+    fn output_placement(&self) -> gpui::OutputPlacement {
+        let state = self.borrow();
+        if state.scaled && !state.outputs.is_empty() {
+            gpui::OutputPlacement::Placed
+        } else {
+            gpui::OutputPlacement::Pending
+        }
+    }
+
     fn gpu_specs(&self) -> Option<GpuSpecs> {
         self.borrow().renderer.as_ref()?.gpu_specs()
     }
-- 
